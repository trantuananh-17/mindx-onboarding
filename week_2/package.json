{
  "name": "week-2-ticket-manager-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Ticket Manager CLI developed with Test-Driven Development",
  "type": "module",
  "bin": {
    "tickets": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "precli": "pnpm build",
    "cli": "node dist/cli/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
